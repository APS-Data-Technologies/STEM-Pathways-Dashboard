{
  "name": "stem-pathways-dashboard",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "data:build": "python scripts/build_data.py",
    "data:verify": "python scripts/verify_data.py",
    "format": "prettier --write src tests index.html package.json"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "vite": "8.3.6"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
